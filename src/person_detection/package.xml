<?xml version="1.0"?>
<package format="3">
  <name>person_detection</name>
  <version>1.0.0</version>
  <description>YOLOv8 person detection for maze drone</description>
  <maintainer email="dev@auto.drone">Auto Drone</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- NumPy MUST stay < 2.0.0: ROS 2 python3-opencv on ARM64 breaks with
       AttributeError: _ARRAY_API not found under NumPy 2.x.
       See requirements.txt / constraints.txt and setup_vm_env.sh. -->
  <exec_depend version_lt="2.0.0">python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
